DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_STATIC_ROOT=staticfiles
DJANGO_LOG_LEVEL=INFO

# Production HTTPS/security hardening. Keep false/0 for local HTTP development.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_USE_X_FORWARDED_PROTO=false
JWT_ACCESS_TOKEN_MINUTES=720
JWT_REFRESH_TOKEN_DAYS=1

# Frontend URL used in generated password-reset links.
FRONTEND_BASE_URL=http://localhost:5173

# Email defaults. Console backend is suitable for local development only.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost
DJANGO_SERVER_EMAIL=no-reply@localhost
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false

DB_NAME=db_riat
DB_USER=riat_admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
# Set DB_ENGINE=sqlite for local checks that should not require MySQL.
DB_ENGINE=mysql
SQLITE_DB_PATH=db.sqlite3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_TIMEOUT_SECONDS=45
